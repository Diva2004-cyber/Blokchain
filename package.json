{
  "name": "academic-credential-blockchain",
  "version": "1.0.0",
  "description": "Prototype Sistem Verifikasi Kredensial Akademik Berbasis Blockchain - UTS OBE 2026/2027",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npx hardhat compile",
    "typecheck": "tsc --noEmit",
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "test:security": "npx hardhat test tests/security/CredentialRegistry.security.test.ts tests/security/Acceptance.security.test.ts",
    "test:issuance": "npx hardhat test tests/integration/Issuance.integration.test.ts",
    "test:verification": "npx hardhat test tests/integration/Verification.integration.test.ts",
    "test:lifecycle": "npx hardhat test tests/integration/Lifecycle.integration.test.ts",
    "test:acceptance": "npx hardhat test tests/security/Acceptance.security.test.ts",
    "scan:secrets": "ts-node scripts/secret-scan.ts",
    "benchmark": "npx hardhat run tests/performance/benchmark.ts",
    "simulate:consortium": "npx hardhat run scripts/simulate-consortium.ts",
    "test:all": "npx hardhat test blockchain/test/CredentialRegistry.test.ts tests/security/CredentialRegistry.security.test.ts tests/security/Acceptance.security.test.ts tests/integration/Issuance.integration.test.ts tests/integration/Verification.integration.test.ts tests/integration/Lifecycle.integration.test.ts",
    "dev": "npm run dev --workspace=apps/portal"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.0",
    "chai": "^4.5.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "hardhat": "^2.22.18",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "blockchain",
    "verifiable-credentials",
    "w3c-vc",
    "smart-contract",
    "solidity",
    "academic-credential",
    "ethereum"
  ],
  "author": "UTS Blockchain Project Team",
  "license": "UNLICENSED"
}
