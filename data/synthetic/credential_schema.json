{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.edu/schemas/academic-credential-v2.json",
  "title": "Academic Degree Verifiable Credential Schema (W3C VC v2.0 Synthetic)",
  "type": "object",
  "required": [
    "@context",
    "id",
    "type",
    "issuer",
    "validFrom",
    "credentialSubject",
    "credentialStatus",
    "proof"
  ],
  "properties": {
    "@context": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "id": {
      "type": "string",
      "pattern": "^(urn:uuid:[a-f0-9\\-]+|urn:credential:academic:[a-zA-Z0-9\\-]+)$"
    },
    "type": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "VerifiableCredential" }
    },
    "issuer": {
      "type": "object",
      "required": ["id", "name", "ethereumAddress"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ethereumAddress": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$"
        }
      }
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "credentialSubject": {
      "type": "object",
      "required": [
        "id",
        "studentIdentifier",
        "fullName",
        "degreeName",
        "studyProgram",
        "faculty",
        "gpa",
        "graduationDate"
      ],
      "properties": {
        "id": { "type": "string" },
        "studentIdentifier": { "type": "string" },
        "fullName": { "type": "string" },
        "degreeName": { "type": "string" },
        "studyProgram": { "type": "string" },
        "faculty": { "type": "string" },
        "gpa": { "type": "string" },
        "graduationDate": { "type": "string" },
        "honors": { "type": "string" }
      }
    },
    "credentialStatus": {
      "type": "object",
      "required": ["id", "type", "registryAddress", "credentialIdOnChain"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "registryAddress": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$"
        },
        "credentialIdOnChain": { "type": "string" }
      }
    },
    "proof": {
      "type": "object",
      "required": [
        "type",
        "created",
        "verificationMethod",
        "proofPurpose",
        "proofValue"
      ],
      "properties": {
        "type": { "type": "string" },
        "created": { "type": "string" },
        "verificationMethod": { "type": "string" },
        "proofPurpose": { "type": "string" },
        "proofValue": { "type": "string" }
      }
    }
  }
}
